__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/

# Data and artefacts are never committed; see README for how to fetch them.
# Anchored to the repo root (leading slash) -- an unanchored "data/" also
# matches src/filament/data/, which silently excluded the entire data
# pipeline module from every commit until this was caught by a git-status
# check during the P0 real-data audit. See the fix commit for the history.
/data/
/outputs/
/checkpoints/
*.pth
*.ckpt
submission.csv

# Scratch working directories used by the Kaggle-connected session when
# pushing kernels/datasets to Kaggle (dataset-metadata.json, kernel-
# metadata.json, and copies of source files staged for upload). These are
# build artefacts of a separate tool operating in this same repo checkout,
# not part of the source tree -- caught after a `git add -A` swept one in
# along with a 46MB duplicated annotation JSON.
/kaggle_dataset_push/
/kaggle_kernel_push/
